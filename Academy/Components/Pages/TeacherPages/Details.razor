@page "/teachers/details"
@using Microsoft.EntityFrameworkCore

@using Academy.Models
@using Academy.Components.Controls;

@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

@* <PageTitle>Details</PageTitle>

<h1>Details</h1> *@

<div>
@*     <h2>Teacher</h2>
    <hr /> *@
    @if (teacher is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@teacher.FullName</h1>
            <a href="@($"/teachers/edit?teacher_id={teacher.teacher_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />
        <div class="human-container">
            <dl class="row">
                <dt class="col-sm-2">work_since</dt>
                <dd class="col-sm-10">@teacher.work_since</dd>
                <dt class="col-sm-2">rate</dt>
                <dd class="col-sm-10">@teacher.rate</dd>
                <dt class="col-sm-2">last_name</dt>
                <dd class="col-sm-10">@teacher.last_name</dd>
                <dt class="col-sm-2">first_name</dt>
                <dd class="col-sm-10">@teacher.first_name</dd>
                <dt class="col-sm-2">middle_name</dt>
                <dd class="col-sm-10">@teacher.middle_name</dd>
                <dt class="col-sm-2">birth_date</dt>
                <dd class="col-sm-10">@teacher.birth_date</dd>
                <dt class="col-sm-2">email</dt>
                <dd class="col-sm-10">@teacher.email</dd>
                <dt class="col-sm-2">phone</dt>
                <dd class="col-sm-10">@teacher.phone</dd>
                <dt class="col-sm-2">photo</dt>
                <dd class="col-sm-10">@teacher.photo</dd>
            </dl>
            <Photo Human="teacher" />
        </div>


        <hr />
        //список дисциплин 
        <h3>Дисциплины: @teacher.TDR.Count</h3>



        <ul>
            @if (teacher.TDR.Count == 0)
            {
                <p>У преподавателя нет дисциплин.</p>
            }
            else
            {
                <ul>
                    @foreach (TeachersDisciplinesRelation tdr in teacher.TDR)
                    {
                        <li>@tdr.Discipline.discipline_name</li>
                    }
                </ul>
            }
        </ul>



        //переход на страницу для создания новой связи дисциплины + учитель
        <a href="@($"/teachers/add-discipline?teacher_id={teacher.teacher_id}")" class="btn btn-success"> Добавить дисциплину </a>


        //Переход назад на страницу учителей
        <div>
            <a href="@($"/teachers")">Back to List</a>
        </div>
    }
</div>

@code {
    private Teacher? teacher;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using Academy.Data.AcademyContext context = DbFactory.CreateDbContext();
        teacher = await context.Teachers
                                .Include(t=>t.TDR)
                                .ThenInclude(tdr=>tdr.Discipline)
                                .FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
