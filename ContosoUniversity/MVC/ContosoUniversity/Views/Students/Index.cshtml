@* @model IEnumerable<ContosoUniversity.Models.Student>
 *@
 @model PaginatedList<Student> 

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>
<form asp-action="Index" method="get">
    <lable>
        Поиск по имени:
        <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"/>
        <input type="submit" value="Поиск" class="btn btn-primary"/>    
        <a asp-action="Index" class="btn btn-dark">Сброс</a>
    </lable>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["NameSortParam"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]">
                        LastName
                        @* @Html.DisplayNameFor(model=>model.LastName) *@
                    </a>
                    @*                 @Html.DisplayNameFor(model => model.LastName) *@
                </th>
                <th>
                    FirstName
                    @* @Html.DisplayNameFor(model => model.FirstName) *@
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["DateSortParam"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]">
                        EnrollmentDate
                        @* @Html.DisplayNameFor(model=>model.EnrollmentDate) *@
                    </a>
                    @* @Html.DisplayNameFor(model => model.EnrollmentDate) *@
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EnrollmentDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

@{
    string prevDisabled = Model.HasPreviosPage ? "" : "disable";
    string nextDisabled = Model.HasNextPage ? "" : "disable";

}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisabled">
        Prev
    </a>

    <div class="pagination-items">
        @for (int i = 1; i < Model.TotalPages; ++i)
        {
            <a asp-action="Index" 
            asp-route-pageIndex="@i" 
            asp-route-searchString="@ViewData["CurrentFilter"]"
            class=@(i == Model.PageIndex ? "selected-page" : "pagination-item")
            >
                @i

            </a>

        }

    </div>


    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>