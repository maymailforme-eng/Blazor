@{
    int currentItemsPerPage =
        (int)(ViewData["CurrentItemsPerPage"] ?? 3);
}

<div class="controls">
    <h1>Students</h1>

    <form asp-action="Index" method="get">
        @* Сохраняем сортировку при поиске и изменении размера страницы. 
           Сохраняем скрытно - т.е. без явного выбора 
        *@
        <input type="hidden"
               name="sortOrder"
               value="@ViewData["CurrentSort"]" />

        <label>
            Поиск по имени:

            <input type="search"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]" />
        </label>

        <label for="items-per-page">
            Items per page
        </label>

        @* Добавили items-per-page сохраняет значение при переходе  *@
        @* При изменение размера переотправляем форму  onchange="this.form.submit()*@
        <select id="items-per-page" 
                name="itemsPerPage"
                onchange="this.form.submit()">

            <option value="3" selected="@(currentItemsPerPage == 3)"> 3
            </option>

            <option value="5" selected="@(currentItemsPerPage == 5)"> 5
            </option>

            <option value="8" selected="@(currentItemsPerPage == 8)"> 8
            </option>
        </select>

        <input type="submit" value="Поиск" class="btn btn-primary" />

        <a asp-action="Index" class="btn btn-dark">Сброс</a>
    </form>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
</div>




<div class="table-container">
